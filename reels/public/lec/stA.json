{"id": "stA", "dur": 57.4, "title": "5 TA SO'Z", "cover": ["capital", 21.6], "scenes": [{"a": 0, "b": 16, "k": "askAli"}, {"a": 16, "b": 24, "k": "capital"}, {"a": 24, "b": 30.3, "k": "roots"}, {"a": 30.3, "b": 35.5, "k": "heart"}, {"a": 35.5, "b": 40.2, "k": "horse"}, {"a": 40.2, "b": 47.4, "k": "walkLamp"}, {"a": 47.4, "b": 52.5, "k": "chestOpen"}, {"a": 52.5, "b": 57.4, "k": "sorrow"}], "subs": [{"a": 0.2, "b": 5.5, "t": "Ali ibn Abu Tolib roziyallohu anhu rivoyat qiladi:", "ar": false}, {"a": 5.7, "b": 9.6, "t": "سَأَلْتُ رَسُولَ اللَّهِ ﷺ عَنْ سُنَّتِهِ", "ar": true}, {"a": 9.8, "b": 15.8, "t": "Rasululloh sollallohu alayhi vasallamdan sunnatlari haqida so'radim.", "ar": false}, {"a": 16.0, "b": 18.2, "t": "Shunda Rasululloh dedilar:", "ar": false}, {"a": 18.3, "b": 20.7, "t": "الْمَعْرِفَةُ رَأْسُ مَالِي", "ar": true}, {"a": 20.8, "b": 24.0, "t": "Ma'rifat mening sarmoyamdir,", "ar": false}, {"a": 24.0, "b": 26.9, "t": "وَالْعَقْلُ أَصْلُ دِينِي", "ar": true}, {"a": 27.0, "b": 30.1, "t": "aql dinimning asosi,", "ar": false}, {"a": 30.3, "b": 32.3, "t": "وَالْحُبُّ أَسَاسِي", "ar": true}, {"a": 32.7, "b": 35.4, "t": "muhabbat poydevorim,", "ar": false}, {"a": 35.5, "b": 37.9, "t": "وَالشَّوْقُ مَرْكَبِي", "ar": true}, {"a": 38.0, "b": 40.1, "t": "shavq ulovim,", "ar": false}, {"a": 40.2, "b": 42.1, "t": "وَذِكْرُ اللَّهِ أَنِيسِي", "ar": true}, {"a": 42.4, "b": 46.8, "t": "Allohning zikri hamrohim, tasallim,", "ar": false}, {"a": 47.5, "b": 49.5, "t": "وَالثِّقَةُ كَنْزِي", "ar": true}, {"a": 49.7, "b": 52.4, "t": "ishonch xazinamdir,", "ar": false}, {"a": 52.6, "b": 54.5, "t": "وَالْحُزْنُ رَفِيقِي", "ar": true}, {"a": 54.7, "b": 57.1, "t": "g'am yo'ldoshimdir.", "ar": false}]}