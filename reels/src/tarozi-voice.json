 "subs": [
  {
   "from": 0.08,
   "to": 1.11,
   "text": "*Tarozichilar.*"
  },
  {
   "from": 1.52,
   "to": 2.84,
   "text": "Bular ham o'z ishining"
  },
  {
   "from": 2.84,
   "to": 4.57,
   "text": "ayyorligini yaxshi bilishadi."
  },
  {
   "from": 5.1,
   "to": 7.05,
   "text": "Tarozi tosh bilan o'lchanadi-ku."
  },
  {
   "from": 7.38,
   "to": 9.26,
   "text": "Ana o'sha *toshning* o'zi"
  },
  {
   "from": 9.26,
   "to": 10.51,
   "text": "yengil bo'lib chiqadi."
  },
  {
   "from": 10.92,
   "to": 12.63,
   "text": "Toshning tagini qirib qo'yishadi."
  },
  {
   "from": 13.18,
   "to": 15.06,
   "text": "Pallaning ostiga *qo'rg'oshin*"
  },
  {
   "from": 15.06,
   "to": 16.05,
   "text": "yopishtirishadi."
  },
  {
   "from": 16.16,
   "to": 17.66,
   "text": "Yo bo'lmasa barmog'ini"
  },
  {
   "from": 17.66,
   "to": 19.08,
   "text": "pallaning tagiga sekin"
  },
  {
   "from": 19.08,
   "to": 19.77,
   "text": "tiraydi."
  },
  {
   "from": 20.76,
   "to": 21.82,
   "text": "Qo'shni do'konda tarozi"
  },
  {
   "from": 21.82,
   "to": 22.57,
   "text": "*to'g'ri.*"
  },
  {
   "from": 22.88,
   "to": 24.16,
   "text": "Ustiga bir hovuch ham qo'shib"
  },
  {
   "from": 24.16,
   "to": 24.83,
   "text": "beradi."
  },
  {
   "from": 25.14,
   "to": 26.68,
   "text": "Kechqurun odam shu do'konga"
  },
  {
   "from": 26.68,
   "to": 27.69,
   "text": "navbatga turadi."
  },
  {
   "from": 27.96,
   "to": 29.21,
   "text": "O'zlari yaxshi biladi."
  },
  {
   "from": 29.92,
   "to": 31.41,
   "text": "Madinada ham shunday bo'lgan."
  },
  {
   "from": 31.9,
   "to": 33.04,
   "text": "Ibn Abbos aytadilar,"
  },
  {
   "from": 33.04,
   "to": 34.06,
   "text": "Payg'ambarimiz sollallohu"
  },
  {
   "from": 34.06,
   "to": 35.42,
   "text": "alayhi vasallam Madinaga"
  },
  {
   "from": 35.42,
   "to": 37.42,
   "text": "kelganlarida, ahli o'lchovda"
  },
  {
   "from": 37.42,
   "to": 38.88,
   "text": "eng ko'p *aldaydiganlardan*"
  },
  {
   "from": 38.88,
   "to": 39.39,
   "text": "edi."
  },
  {
   "from": 39.86,
   "to": 41.6,
   "text": "Shunda *Mutaffifin* surasi"
  },
  {
   "from": 41.6,
   "to": 42.23,
   "text": "tushdi."
  },
  {
   "from": 43.04,
   "to": 44.52,
   "text": "Birodarlar, Alloh taolo"
  },
  {
   "from": 44.52,
   "to": 45.17,
   "text": "aytadi."
  },
  {
   "from": 45.98,
   "to": 47.48,
   "text": "*Voy bo'lsin* o'lchovdan"
  },
  {
   "from": 47.48,
   "to": 48.63,
   "text": "urib qoluvchilarga."
  },
  {
   "from": 49.16,
   "to": 50.6,
   "text": "Ular odamlardan narsa o'lchab"
  },
  {
   "from": 50.6,
   "to": 52.43,
   "text": "olsalar, to'liq olarlar."
  },
  {
   "from": 52.74,
   "to": 53.92,
   "text": "Odamlarga o'lchab yoki"
  },
  {
   "from": 53.92,
   "to": 55.05,
   "text": "tortib bersalar,"
  },
  {
   "from": 55.08,
   "to": 56.25,
   "text": "*kamaytirarlar.*"
  },
  {
   "from": 57.04,
   "to": 58.14,
   "text": "Aldasam, hech kim bilmaydi,"
  },
  {
   "from": 58.14,
   "to": 59.09,
   "text": "deb o'ylaysiz."
  },
  {
   "from": 59.48,
   "to": 60.71,
   "text": "Oyat esa *so'raydi.*"
  },
  {
   "from": 61.42,
   "to": 63.15,
   "text": "Bular qayta tirilishlarini"
  },
  {
   "from": 63.32,
   "to": 64.69,
   "text": "o'ylamaydilarmi?"
  }
 ]
}