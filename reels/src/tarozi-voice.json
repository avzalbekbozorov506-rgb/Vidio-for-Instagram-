 "subs": [
  {
   "from": 0.08,
   "to": 2.46,
   "text": "*Tarozichilar.* Bular ham o'z"
  },
  {
   "from": 2.46,
   "to": 3.84,
   "text": "ishining ayyorligini yaxshi"
  },
  {
   "from": 3.84,
   "to": 6.2,
   "text": "bilishadi. Tarozi tosh bilan"
  },
  {
   "from": 6.2,
   "to": 8.28,
   "text": "o'lchanadi-ku. Ana o'sha"
  },
  {
   "from": 8.28,
   "to": 9.86,
   "text": "*toshning* o'zi yengil bo'lib"
  },
  {
   "from": 9.86,
   "to": 10.46,
   "text": "chiqadi."
  },
  {
   "from": 10.92,
   "to": 12.58,
   "text": "Toshning tagini qirib qo'yishadi."
  },
  {
   "from": 13.18,
   "to": 15.06,
   "text": "Pallaning ostiga *qo'rg'oshin*"
  },
  {
   "from": 15.06,
   "to": 17.0,
   "text": "yopishtirishadi. Yo bo'lmasa"
  },
  {
   "from": 17.08,
   "to": 18.64,
   "text": "barmog'ini pallaning tagiga"
  },
  {
   "from": 18.64,
   "to": 19.72,
   "text": "sekin tiraydi."
  },
  {
   "from": 20.76,
   "to": 22.52,
   "text": "Qo'shni do'konda tarozi *to'g'ri.*"
  },
  {
   "from": 22.88,
   "to": 24.16,
   "text": "Ustiga bir hovuch ham qo'shib"
  },
  {
   "from": 24.16,
   "to": 26.28,
   "text": "beradi. Kechqurun odam shu"
  },
  {
   "from": 26.28,
   "to": 27.64,
   "text": "do'konga navbatga turadi."
  },
  {
   "from": 27.96,
   "to": 29.16,
   "text": "O'zlari yaxshi biladi."
  },
  {
   "from": 29.92,
   "to": 31.36,
   "text": "Madinada ham shunday bo'lgan."
  },
  {
   "from": 31.9,
   "to": 33.04,
   "text": "Ibn Abbos aytadilar,"
  },
  {
   "from": 33.04,
   "to": 34.06,
   "text": "Payg'ambarimiz sollallohu"
  },
  {
   "from": 34.06,
   "to": 35.42,
   "text": "alayhi vasallam Madinaga"
  },
  {
   "from": 35.42,
   "to": 37.42,
   "text": "kelganlarida, ahli o'lchovda"
  },
  {
   "from": 37.42,
   "to": 38.88,
   "text": "eng ko'p *aldaydiganlardan*"
  },
  {
   "from": 38.88,
   "to": 41.6,
   "text": "edi. Shunda *Mutaffifin* surasi"
  },
  {
   "from": 41.6,
   "to": 42.18,
   "text": "tushdi."
  },
  {
   "from": 43.04,
   "to": 45.12,
   "text": "Birodarlar, Alloh taolo aytadi."
  },
  {
   "from": 45.98,
   "to": 47.66,
   "text": "*Voy bo'lsin* o'lchovdan urib"
  },
  {
   "from": 47.66,
   "to": 50.02,
   "text": "qoluvchilarga. Ular odamlardan"
  },
  {
   "from": 50.02,
   "to": 51.3,
   "text": "narsa o'lchab olsalar,"
  },
  {
   "from": 51.3,
   "to": 52.38,
   "text": "to'liq olarlar."
  },
  {
   "from": 52.74,
   "to": 54.28,
   "text": "Odamlarga o'lchab yoki tortib"
  },
  {
   "from": 54.28,
   "to": 56.2,
   "text": "bersalar, *kamaytirarlar.*"
  },
  {
   "from": 57.04,
   "to": 58.14,
   "text": "Aldasam, hech kim bilmaydi,"
  },
  {
   "from": 58.14,
   "to": 59.04,
   "text": "deb o'ylaysiz."
  },
  {
   "from": 59.48,
   "to": 60.66,
   "text": "Oyat esa *so'raydi.*"
  },
  {
   "from": 61.42,
   "to": 63.1,
   "text": "Bular qayta tirilishlarini"
  },
  {
   "from": 63.32,
   "to": 64.64,
   "text": "o'ylamaydilarmi?"
  }
 ]
}