 "subs": [
  {
   "from": 1.55,
   "to": 4.714,
   "text": "*Tarozichilar.*"
  },
  {
   "from": 4.714,
   "to": 6.307,
   "text": "Bular ham o'z ishining ayyorligini"
  },
  {
   "from": 6.307,
   "to": 7.104,
   "text": "yaxshi bilishadi."
  },
  {
   "from": 7.104,
   "to": 10.569,
   "text": "Tarozi tosh bilan o'lchanadi-ku."
  },
  {
   "from": 10.569,
   "to": 11.474,
   "text": "Ana o'sha *toshning* o'zi"
  },
  {
   "from": 11.474,
   "to": 12.34,
   "text": "yengil bo'lib chiqadi."
  },
  {
   "from": 13.23,
   "to": 14.795,
   "text": "Toshning tagini qirib qo'yishadi."
  },
  {
   "from": 14.795,
   "to": 15.544,
   "text": "Pallaning ostiga *qo'rg'oshin*"
  },
  {
   "from": 15.544,
   "to": 15.973,
   "text": "yopishtirishadi."
  },
  {
   "from": 15.973,
   "to": 18.096,
   "text": "Yo bo'lmasa barmog'ini pallaning"
  },
  {
   "from": 18.096,
   "to": 19.49,
   "text": "tagiga sekin tiraydi."
  },
  {
   "from": 20.81,
   "to": 22.691,
   "text": "Qo'shni do'konda tarozi *to'g'ri.*"
  },
  {
   "from": 22.691,
   "to": 24.461,
   "text": "Ustiga bir hovuch ham qo'shib"
  },
  {
   "from": 24.461,
   "to": 24.888,
   "text": "beradi."
  },
  {
   "from": 24.888,
   "to": 26.627,
   "text": "Kechqurun odam shu do'konga"
  },
  {
   "from": 26.627,
   "to": 27.658,
   "text": "navbatga turadi."
  },
  {
   "from": 27.658,
   "to": 28.9,
   "text": "O'zlari yaxshi biladi."
  },
  {
   "from": 29.97,
   "to": 31.278,
   "text": "Madinada ham shunday bo'lgan."
  },
  {
   "from": 31.278,
   "to": 32.581,
   "text": "Ibn Abbos aytadilar,"
  },
  {
   "from": 32.581,
   "to": 34.209,
   "text": "Payg'ambarimiz sollallohu"
  },
  {
   "from": 34.209,
   "to": 35.772,
   "text": "alayhi vasallam Madinaga"
  },
  {
   "from": 35.772,
   "to": 37.596,
   "text": "kelganlarida, ahli o'lchovda"
  },
  {
   "from": 37.596,
   "to": 39.224,
   "text": "eng ko'p *aldaydiganlardan*"
  },
  {
   "from": 39.224,
   "to": 39.484,
   "text": "edi."
  },
  {
   "from": 39.484,
   "to": 41.393,
   "text": "Shunda *Mutaffifin* surasi"
  },
  {
   "from": 41.393,
   "to": 41.95,
   "text": "tushdi."
  },
  {
   "from": 43.08,
   "to": 45.39,
   "text": "Birodarlar, Alloh taolo aytadi."
  },
  {
   "from": 45.39,
   "to": 47.21,
   "text": "*Voy bo'lsin* o'lchovdan"
  },
  {
   "from": 47.21,
   "to": 48.782,
   "text": "urib qoluvchilarga."
  },
  {
   "from": 48.782,
   "to": 50.778,
   "text": "Ular odamlardan narsa o'lchab"
  },
  {
   "from": 50.778,
   "to": 52.43,
   "text": "olsalar, to'liq olarlar."
  },
  {
   "from": 52.43,
   "to": 54.356,
   "text": "Odamlarga o'lchab yoki tortib"
  },
  {
   "from": 54.356,
   "to": 55.95,
   "text": "bersalar, *kamaytirarlar.*"
  },
  {
   "from": 57.05,
   "to": 58.434,
   "text": "Aldasam, hech kim bilmaydi,"
  },
  {
   "from": 58.434,
   "to": 59.151,
   "text": "deb o'ylaysiz."
  },
  {
   "from": 59.151,
   "to": 60.934,
   "text": "Oyat esa *so'raydi.*"
  },
  {
   "from": 60.934,
   "to": 62.894,
   "text": "Bular qayta tirilishlarini"
  },
  {
   "from": 62.894,
   "to": 64.1,
   "text": "o'ylamaydilarmi?"
  }
 ]
}