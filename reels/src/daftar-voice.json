 "subs": [
  {
   "from": 0.32,
   "to": 1.63,
   "text": "Yaxshilik qildingiz,"
  },
  {
   "from": 1.78,
   "to": 3.11,
   "text": "rahmat eshitmadingiz."
  },
  {
   "from": 3.44,
   "to": 4.73,
   "text": "Ko'nglingiz og'ridi."
  },
  {
   "from": 4.98,
   "to": 5.59,
   "text": "Nega?"
  },
  {
   "from": 5.96,
   "to": 7.95,
   "text": "Chunki siz uni sovg'a qilmadingiz."
  },
  {
   "from": 8.2,
   "to": 9.43,
   "text": "*Qarzga* berdingiz."
  },
  {
   "from": 9.7,
   "to": 11.21,
   "text": "Hatto yozib ham qo'ydingiz."
  },
  {
   "from": 11.48,
   "to": 12.56,
   "text": "Ichingizda bitta daftar"
  },
  {
   "from": 12.56,
   "to": 13.09,
   "text": "bor."
  },
  {
   "from": 13.26,
   "to": 14.76,
   "text": "Unda kim sizga nima qilgani"
  },
  {
   "from": 14.76,
   "to": 15.55,
   "text": "yozilgan."
  },
  {
   "from": 15.78,
   "to": 17.05,
   "text": "Siz buni sezmaysiz."
  },
  {
   "from": 17.14,
   "to": 18.28,
   "text": "Lekin yaxshilik qilishingiz"
  },
  {
   "from": 18.28,
   "to": 20.39,
   "text": "bilan, daftar o'zi ochiladi."
  },
  {
   "from": 20.72,
   "to": 22.13,
   "text": "Tug'ilgan kuningiz keldi."
  },
  {
   "from": 22.32,
   "to": 24.17,
   "text": "Do'stingiz bir og'iz tabriklamadi."
  },
  {
   "from": 24.3,
   "to": 25.5,
   "text": "Siz o'tgan yili unga olgan"
  },
  {
   "from": 25.5,
   "to": 27.55,
   "text": "sovg'angizni darrov eslaysiz."
  },
  {
   "from": 27.88,
   "to": 29.32,
   "text": "U esa bu daftarni hech"
  },
  {
   "from": 29.32,
   "to": 30.43,
   "text": "qachon ko'rmagan."
  },
  {
   "from": 30.68,
   "to": 32.47,
   "text": "U qarz olganini ham bilmaydi."
  },
  {
   "from": 32.66,
   "to": 34.04,
   "text": "Siz esa uning *qarzini* sanab"
  },
  {
   "from": 34.04,
   "to": 34.77,
   "text": "yurasiz."
  },
  {
   "from": 35.12,
   "to": 36.06,
   "text": "Keyingi safar yaxshilik"
  },
  {
   "from": 36.06,
   "to": 37.82,
   "text": "qilsangiz, daftarni ochmay"
  },
  {
   "from": 37.82,
   "to": 38.95,
   "text": "qo'ysangiz bo'ladi."
  },
  {
   "from": 39.32,
   "to": 40.8,
   "text": "Rahmat demagan odam ko'nglingizni"
  },
  {
   "from": 40.8,
   "to": 41.61,
   "text": "og'ritmadi."
  },
  {
   "from": 41.84,
   "to": 43.27,
   "text": "*Daftar* og'ritdi."
  }
 ]
}