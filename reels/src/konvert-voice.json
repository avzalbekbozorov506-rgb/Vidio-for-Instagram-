 "subs": [
  {
   "from": 0.26,
   "to": 1.817,
   "text": "Dadam meni hech qachon"
  },
  {
   "from": 1.817,
   "to": 3.207,
   "text": "quchoqlamagan."
  },
  {
   "from": 3.417,
   "to": 4.764,
   "text": "Bir marta ham."
  },
  {
   "from": 4.974,
   "to": 6.603,
   "text": "Lekin menda uning bitta"
  },
  {
   "from": 6.603,
   "to": 7.9,
   "text": "*konverti* bor."
  },
  {
   "from": 8.11,
   "to": 9.864,
   "text": "Ichida nima bor edi?"
  },
  {
   "from": 10.074,
   "to": 12.203,
   "text": "O'n sakkiz yoshimda Toshkentga"
  },
  {
   "from": 12.203,
   "to": 13.714,
   "text": "o'qishga ketdim."
  },
  {
   "from": 13.924,
   "to": 16.124,
   "text": "Bekatda dadam avtobus kelguncha"
  },
  {
   "from": 16.124,
   "to": 17.9,
   "text": "bir og'iz gapirmadi."
  },
  {
   "from": 18.11,
   "to": 20.1,
   "text": "Keyin konvertni uzatdi."
  },
  {
   "from": 20.31,
   "to": 21.96,
   "text": "Yo'lingda ehtiyot bo'l,"
  },
  {
   "from": 21.96,
   "to": 22.707,
   "text": "dedi."
  },
  {
   "from": 22.917,
   "to": 24.214,
   "text": "Yuzini burdi."
  },
  {
   "from": 24.424,
   "to": 26.007,
   "text": "Avtobusda ochdim."
  },
  {
   "from": 26.217,
   "to": 28.081,
   "text": "Ichida g'ijimlangan pullar"
  },
  {
   "from": 28.081,
   "to": 28.757,
   "text": "edi."
  },
  {
   "from": 28.967,
   "to": 31.239,
   "text": "Bir so'mini ortiqcha sarflamagan"
  },
  {
   "from": 31.239,
   "to": 32.607,
   "text": "odamning puli."
  },
  {
   "from": 32.817,
   "to": 34.446,
   "text": "Tagida yana nimadir bor"
  },
  {
   "from": 34.446,
   "to": 35.121,
   "text": "edi."
  },
  {
   "from": 35.331,
   "to": 37.107,
   "text": "Bukilgan bir qog'oz."
  },
  {
   "from": 37.317,
   "to": 38.874,
   "text": "Dadam umrida menga xat"
  },
  {
   "from": 38.874,
   "to": 40.171,
   "text": "yozmagan edi."
  },
  {
   "from": 40.381,
   "to": 42.229,
   "text": "Harflari qiyshiq edi."
  },
  {
   "from": 42.439,
   "to": 44.6,
   "text": "Qog'ozda ikki gap bor edi."
  },
  {
   "from": 44.81,
   "to": 45.767,
   "text": "Qiyin bo'lsa,"
  },
  {
   "from": 45.767,
   "to": 46.921,
   "text": "qaytib kel."
  },
  {
   "from": 47.131,
   "to": 48.836,
   "text": "*Eshigim* doim ochiq."
  },
  {
   "from": 49.046,
   "to": 50.7,
   "text": "Derazadan qaradim."
  },
  {
   "from": 50.91,
   "to": 52.539,
   "text": "Dadam hamon o'sha yerda"
  },
  {
   "from": 52.539,
   "to": 53.5,
   "text": "turardi."
  },
  {
   "from": 53.71,
   "to": 55.646,
   "text": "Aytolmagan gapini konvertga"
  },
  {
   "from": 55.646,
   "to": 56.871,
   "text": "yozgan ekan."
  },
  {
   "from": 57.081,
   "to": 58.639,
   "text": "Dadam meni hech qachon"
  },
  {
   "from": 58.639,
   "to": 60.029,
   "text": "quchoqlamagan."
  },
  {
   "from": 60.239,
   "to": 62.081,
   "text": "Lekin eshigini hech qachon"
  },
  {
   "from": 62.081,
   "to": 63.114,
   "text": "*yopmagan*."
  }
 ]
}