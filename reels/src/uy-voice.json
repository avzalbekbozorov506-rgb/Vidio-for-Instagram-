 "subs": [
  {
   "from": 0.24,
   "to": 2.09,
   "text": "Uyingizda uchta narsa bor."
  },
  {
   "from": 2.14,
   "to": 3.63,
   "text": "Ko'pchilik ularni bilmaydi."
  },
  {
   "from": 3.84,
   "to": 5.39,
   "text": "Oxirgisi eng *xavfli*."
  },
  {
   "from": 5.86,
   "to": 7.19,
   "text": "Birinchisi, *sochiq*."
  },
  {
   "from": 7.56,
   "to": 8.84,
   "text": "Uni yuvganda konditsioner"
  },
  {
   "from": 8.84,
   "to": 10.12,
   "text": "qo'shsangiz, sochiq yumshoq"
  },
  {
   "from": 10.12,
   "to": 10.79,
   "text": "bo'ladi."
  },
  {
   "from": 10.84,
   "to": 12.34,
   "text": "Lekin tolalarni yupqa parda"
  },
  {
   "from": 12.34,
   "to": 13.66,
   "text": "qoplaydi, sochiq suvni"
  },
  {
   "from": 13.66,
   "to": 14.57,
   "text": "yomon shimadi."
  },
  {
   "from": 14.94,
   "to": 16.41,
   "text": "Ikkinchisi, *muzlatkich*."
  },
  {
   "from": 16.68,
   "to": 17.62,
   "text": "Ko'p muzlatkichlarning"
  },
  {
   "from": 17.62,
   "to": 19.02,
   "text": "ichida, orqa devorda suv"
  },
  {
   "from": 19.02,
   "to": 20.1,
   "text": "oqadigan kichkina teshik"
  },
  {
   "from": 20.1,
   "to": 20.6,
   "text": "bor."
  },
  {
   "from": 20.6,
   "to": 21.94,
   "text": "Tiqilsa, tortmalar tagida"
  },
  {
   "from": 21.94,
   "to": 22.87,
   "text": "suv yig'iladi."
  },
  {
   "from": 22.96,
   "to": 24.1,
   "text": "Teshikni paxtali cho'p"
  },
  {
   "from": 24.1,
   "to": 25.03,
   "text": "bilan tozalang."
  },
  {
   "from": 25.46,
   "to": 26.77,
   "text": "Uchinchisi, *plita*."
  },
  {
   "from": 26.96,
   "to": 28.31,
   "text": "Olovning rangiga qarang."
  },
  {
   "from": 28.4,
   "to": 29.18,
   "text": "Olov *ko'k* bo'lsa,"
  },
  {
   "from": 29.18,
   "to": 29.81,
   "text": "yaxshi."
  },
  {
   "from": 30.02,
   "to": 31.5,
   "text": "Olov doim *SARIQ* bo'lsa,"
  },
  {
   "from": 31.5,
   "to": 32.84,
   "text": "gaz to'liq yonmayapti."
  },
  {
   "from": 32.84,
   "to": 34.62,
   "text": "Shunda hidsiz *zaharli* gaz"
  },
  {
   "from": 34.62,
   "to": 35.5,
   "text": "chiqishi mumkin."
  },
  {
   "from": 35.5,
   "to": 36.83,
   "text": "Gaz xizmatini chaqiring."
  },
  {
   "from": 37.16,
   "to": 38.31,
   "text": "Endi siz bilasiz."
  },
  {
   "from": 38.36,
   "to": 39.46,
   "text": "Plitangiz olovi qanday"
  },
  {
   "from": 39.46,
   "to": 40.33,
   "text": "rangda?"
  }
 ]
}